{
  "openapi": "3.1.0",
  "info": {
    "title": "Rise of Machine Tools API",
    "version": "1.0.0",
    "description": "Read-only discovery API for AI tools (phase 1, static).",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "https://riseofmachine.com/api/v1"
    }
  ],
  "paths": {
    "/index.json": {
      "get": {
        "operationId": "getIndex",
        "summary": "API root (version + links)",
        "responses": {
          "200": {
            "description": "API root",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiRoot"
                }
              }
            }
          }
        }
      }
    },
    "/tools.json": {
      "get": {
        "operationId": "listTools",
        "summary": "Tools, page 1",
        "responses": {
          "200": {
            "description": "Tools page 1",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolCollection"
                }
              }
            }
          }
        }
      }
    },
    "/tools/page/{n}.json": {
      "get": {
        "operationId": "listToolsPage",
        "summary": "Tools, page n",
        "parameters": [
          {
            "name": "n",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 2
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tools page n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolCollection"
                }
              }
            }
          }
        }
      }
    },
    "/tools-all.json": {
      "get": {
        "operationId": "listAllTools",
        "summary": "All tools in one file (bulk, full records)",
        "responses": {
          "200": {
            "description": "All tools",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolCollectionFull"
                }
              }
            }
          }
        }
      }
    },
    "/tools/{slug}.json": {
      "get": {
        "operationId": "getTool",
        "summary": "Single tool",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A tool",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolResource"
                }
              }
            }
          }
        }
      }
    },
    "/tools/category/{id}.json": {
      "get": {
        "operationId": "listCategory",
        "summary": "Category, page 1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Category page 1",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolCollection"
                }
              }
            }
          }
        }
      }
    },
    "/tools/category/{id}/page/{n}.json": {
      "get": {
        "operationId": "listCategoryPage",
        "summary": "Category, page n",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          {
            "name": "n",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 2
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Category page n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolCollection"
                }
              }
            }
          }
        }
      }
    },
    "/categories.json": {
      "get": {
        "operationId": "listCategories",
        "summary": "Categories with counts",
        "responses": {
          "200": {
            "description": "Categories",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryCollection"
                }
              }
            }
          }
        }
      }
    },
    "/search-index.json": {
      "get": {
        "operationId": "searchIndex",
        "summary": "Raw Fuse index for client-side search",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ToolSummary": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "description",
          "url",
          "tag",
          "dateAdded",
          "siteUrl",
          "ogImage",
          "githubUrl",
          "category",
          "featured"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "tag": {
            "type": "string"
          },
          "dateAdded": {
            "type": "string",
            "format": "date"
          },
          "siteUrl": {
            "type": "string",
            "format": "uri"
          },
          "ogImage": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "githubUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "category": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "featured": {
            "type": "boolean"
          }
        }
      },
      "Tool": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ToolSummary"
          },
          {
            "type": "object",
            "required": [
              "body",
              "related"
            ],
            "properties": {
              "body": {
                "type": "string"
              },
              "related": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "ToolResource": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Tool"
          }
        }
      },
      "ToolCollection": {
        "type": "object",
        "required": [
          "data",
          "meta",
          "links"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolSummary"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          },
          "links": {
            "$ref": "#/components/schemas/PageLinks"
          }
        }
      },
      "ToolCollectionFull": {
        "type": "object",
        "required": [
          "data",
          "meta",
          "links"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          },
          "links": {
            "$ref": "#/components/schemas/PageLinks"
          }
        }
      },
      "Category": {
        "type": "object",
        "required": [
          "id",
          "title",
          "count"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "CategoryCollection": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          }
        }
      },
      "ApiRoot": {
        "type": "object",
        "required": [
          "name",
          "version",
          "updated",
          "links"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "updated": {
            "type": "string",
            "format": "date"
          },
          "links": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "PageMeta": {
        "type": "object",
        "required": [
          "total",
          "page",
          "perPage",
          "totalPages"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "perPage": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "PageLinks": {
        "type": "object",
        "required": [
          "self",
          "next",
          "prev",
          "first",
          "last"
        ],
        "properties": {
          "self": {
            "type": "string"
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          },
          "prev": {
            "type": [
              "string",
              "null"
            ]
          },
          "first": {
            "type": "string"
          },
          "last": {
            "type": "string"
          }
        }
      }
    }
  }
}
